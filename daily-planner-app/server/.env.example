# Copy this file to server/.env (which Git ignores) and paste your keys there.
# Server only: never put these keys in client code or commit them.

# Clerk Dashboard → API keys → "Secret key" (starts with sk_test_ or sk_live_).
CLERK_SECRET_KEY=

# Hosted database (Turso). Leave both empty to use the local file
# server/data/planner.db while developing. On Render both are REQUIRED —
# set them in Render → Environment, because Render erases local files.
#   turso db show --url daily-planner      → TURSO_DATABASE_URL (libsql://…)
#   turso db tokens create daily-planner   → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
